---
// PhotoLightboxGrid.astro — rejilla de miniaturas que abre Lightbox.astro
// y permite moverse entre las fotos del mismo grupo (prev/next).
//
// Uso:
//   <PhotoLightboxGrid photos={[{ image: myImage, title: "..." }, ...]} />
//
// Requiere que <Lightbox /> esté presente una única vez en la página
// (escucha los eventos "lightbox:open" / "lightbox:preload" que dispara
// este componente).
//
// Diseño por defecto: grid de 2/3/4 columnas (móvil/sm/lg), miniaturas
// cuadradas con esquinas redondeadas y un efecto de zoom sutil al pasar el
// ratón. Se puede personalizar con los props gridClass / itemClass /
// imgClass / showCaption (ver más abajo).
//
// La imagen grande del Lightbox se genera con getImage() (1600px, webp +
// avif) a partir del ImageMetadata original — no se sirve el archivo tal
// cual se subió.
//
// Prop opcional "photosPerPage": agrupa las fotos en lotes y solo muestra
// el primero al inicio (el resto queda oculto con data-plg-page="N"). Una
// página que use scroll infinito puede ir revelando lotes progresivamente
// quitando la clase "hidden" a los elementos con ese data-plg-page.

import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface PhotoInput {
  image: ImageMetadata;
  title?: string;
  alt?: string;
  description?: string;
  tags?: string[];
  pubDate?: string | number | Date;
}

interface Props {
  photos: PhotoInput[];
  // Legacy: si se pasa (y no se pasa gridClass), se usa el viejo esquema de
  // 1 columna en móvil + N columnas a partir de "md". Se mantiene solo por
  // compatibilidad con usos existentes que ya pasaban "columns" antes de
  // que "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4" fuera el valor por
  // defecto del grid.
  columns?: 1 | 2 | 3 | 4;
  gap?: string; // clase Tailwind, p.ej. "gap-4" o "gap-6"
  imgHeight?: string; // clases Tailwind; solo se usa si no se pasa itemClass
  // Si se indica, las fotos se agrupan en lotes de este tamaño y solo el
  // primer lote se muestra al inicio (el resto queda con class="hidden" y
  // data-plg-page="N"). Pensado para que una página externa (p.ej. scroll
  // infinito) vaya revelando lotes progresivamente. Si no se pasa, el
  // comportamiento es el de siempre: todas las fotos visibles.
  photosPerPage?: number;
  // Sobrescribe TODAS las clases de columnas del grid (incluidos los
  // breakpoints). Por defecto: "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4".
  gridClass?: string;
  // Sobrescribe las clases del contenedor de cada miniatura. Por defecto:
  // "relative aspect-square overflow-hidden rounded-xl bg-base-200".
  itemClass?: string;
  // Clases adicionales para la propia <Image> (además de
  // "w-full h-full object-cover"). Por defecto incluye el efecto hover de
  // escala ("transition-transform duration-300 group-hover:scale-105").
  imgClass?: string;
  // Si es true, se muestra el título debajo de la miniatura. Por defecto
  // no se muestra (el título ya aparece dentro del Lightbox al abrir).
  showCaption?: boolean;
}

const props = Astro.props;
const photos = props.photos;
const photosPerPage = props.photosPerPage;
const gap = props.gap ?? "gap-2 sm:gap-3";
// Compatibilidad: si se pasa "imgHeight" sin "itemClass", se respeta el
// viejo diseño (caja con altura fija). Si no se pasa nada, se usa el
// nuevo diseño cuadrado por defecto.
const itemClass =
  props.itemClass ??
  (props.imgHeight
    ? `w-full overflow-hidden rounded-lg ${props.imgHeight}`
    : "relative aspect-square overflow-hidden rounded-xl bg-base-200");
const imgClass =
  props.imgClass ?? "transition-transform duration-300 group-hover:scale-105";
const showCaption = props.showCaption ?? false;

// El grid "cuadrado" (2/3/4 columnas) es el diseño por defecto. Si alguien
// pasa "columns" explícitamente sin pasar "gridClass", se respeta el
// esquema antiguo (1 col en móvil + N a partir de "md") por compatibilidad.
const legacyColumnsGrid =
  props.columns === 1
    ? "grid-cols-1"
    : props.columns === 2
      ? "grid-cols-1 md:grid-cols-2"
      : props.columns === 3
        ? "grid-cols-1 md:grid-cols-3"
        : "grid-cols-1 md:grid-cols-4";

const gridClass =
  props.gridClass ??
  (props.columns !== undefined
    ? legacyColumnsGrid
    : "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4");

// Lightbox.astro espera pubDate como timestamp numérico (ms o s).
// Si llega como Date o string, lo normalizamos aquí, ANTES de
// serializar a JSON.stringify más abajo: un objeto Date se convierte
// automáticamente en un string ISO al pasar por JSON.stringify, y ese
// string ISO no es un número válido para el formateador del Lightbox.
function toEpochMs(value: string | number | Date | undefined): number | undefined {
  if (value === undefined || value === null || value === "") return undefined;
  if (typeof value === "number") {
    // Timestamp unix con menos de 13 dígitos → asumimos que está en
    // segundos (igual que el schema de content.config.ts) y lo pasamos a
    // milisegundos. `new Date(numero)` interpreta siempre milisegundos,
    // así que sin este ajuste un pubDate en segundos se leería como 1970.
    return value < 1e12 ? value * 1000 : value;
  }
  const d = value instanceof Date ? value : new Date(value);
  const ms = d.getTime();
  return isNaN(ms) ? undefined : ms;
}

// Datos que necesita el Lightbox (src/srcAvif/width/height/title/etc.).
// La imagen grande se genera con getImage() (1600px, webp + avif) en vez
// de servir el archivo original tal cual, igual que las miniaturas ya
// hacían con <Image>.
const lightboxPhotos = await Promise.all(
  photos.map(async (p) => {
    const full = await getImage({
      src: p.image,
      width: 1600,
      format: "webp",
      quality: 80,
    });
    const fullAvif = await getImage({
      src: p.image,
      width: 1600,
      format: "avif",
      quality: 55,
    });

    return {
      src: full.src,
      srcAvif: fullAvif.src,
      width: full.attributes.width,
      height: full.attributes.height,
      title: p.title,
      description: p.description,
      tags: p.tags,
      pubDate: toEpochMs(p.pubDate),
    };
  }),
);

---

<div
  class:list={["plg-grid grid", gap, gridClass]}
  data-plg-photos={JSON.stringify(lightboxPhotos)}
>
  {
    photos.map((photo, i) => {
      const page = photosPerPage ? Math.floor(i / photosPerPage) + 1 : 1;
      return (
        <figure data-plg-page={page} class={page === 1 ? "" : "hidden"}>
          <div class:list={[itemClass]}>
            <button
              type="button"
              class="group cursor-pointer plg-trigger block w-full h-full"
              data-plg-index={i}
              aria-label={`Ver foto: ${photo.title ?? photo.alt ?? ""}`}
            >
              <Image
                src={photo.image}
                alt={photo.alt ?? photo.title ?? ""}
                class:list={["w-full h-full object-cover", imgClass]}
                widths={[600, 900, 1200]}
                loading={i === 0 ? "eager" : "lazy"}
              />
            </button>
          </div>
          {showCaption && photo.title && (
            <figcaption class="mt-1 text-sm text-slate-600">
              {photo.title}
            </figcaption>
          )}
        </figure>
      );
    })
  }
</div>

<script>
  // Nota: este script no recibe datos vía define:vars a propósito.
  // Su contenido es idéntico en cada instancia del componente, así
  // Astro lo deduplica automáticamente aunque uses <PhotoLightboxGrid />
  // varias veces en la misma página (p.ej. una vez para stevia y otra
  // para lavanda). Los datos de cada grupo se leen del atributo
  // data-plg-photos de cada contenedor en tiempo de ejecución.
  function setupPhotoLightboxGrids() {
    const containers = Array.from(
      document.querySelectorAll<HTMLElement>("[data-plg-photos]"),
    );

    containers.forEach((container) => {
      let photos: any[] = [];
      try {
        photos = JSON.parse(container.dataset.plgPhotos ?? "[]");
      } catch {
        photos = [];
      }
      if (!photos.length) return;

      const triggers = Array.from(
        container.querySelectorAll<HTMLButtonElement>(".plg-trigger"),
      );

      triggers.forEach((btn) => {
        const index = Number(btn.dataset.plgIndex ?? 0);

        const preload = () => {
          document.dispatchEvent(
            new CustomEvent("lightbox:preload", { detail: { photos, index } }),
          );
        };
        btn.addEventListener("mouseenter", preload);
        btn.addEventListener("touchstart", preload, { passive: true });

        btn.addEventListener("click", () => {
          document.dispatchEvent(
            new CustomEvent("lightbox:open", {
              detail: { photos, index, triggerEl: btn },
            }),
          );
        });
      });
    });
  }

  document.addEventListener("astro:page-load", setupPhotoLightboxGrids);
</script>
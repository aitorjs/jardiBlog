---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
}

const {
  title,
  description,
  image = "/social_img.webp",
  imageWidth = 1200,
  imageHeight = 630,
  ogType = "website",
} = Astro.props;
---

<meta charset="utf-8" />
<!-- Global Metadata -->
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#e5e5e5" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link
  rel="apple-touch-icon-precomposed"
  sizes="180x180"
  href="/apple-touch-icon.png"
/>

<!-- Primary Meta Tags -->
<title>{title + " | aitor ibañez"}</title>
<meta name="title" content={title + " | aitor ibañez"} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:title" content={title + " | aitor ibañez"} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:image:width" content={imageWidth.toString()} />
<meta property="og:image:height" content={imageHeight.toString()} />
<meta property="og:site_name" content="aitor.info" />
<meta property="og:locale" content="es_ES" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta
  property="twitter:url"
  content={new URL(Astro.url.pathname, Astro.site)}
/>
<meta property="twitter:title" content={title + " | aitor ibañez"} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

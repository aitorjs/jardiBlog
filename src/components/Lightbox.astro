---
// Lightbox.astro — componente reutilizable con View Transitions.
//
// Se abre disparando un CustomEvent desde cualquier parte de la página:
//
//   document.dispatchEvent(new CustomEvent('lightbox:open', {
//     detail: {
//       photos:    [...],   // array de objetos photo
//       index:     0,       // opcional, por defecto 0
//       triggerEl: btn,     // opcional: el elemento DOM clicado (para la view transition)
//     }
//   }))
//
// Si solo hay una foto, los botones prev/next se ocultan automáticamente.
---

<!-- Visor / Lightbox -->
<div id="lightbox" class="not-prose fixed inset-0 z-50 hidden flex-col">
  <div id="lb-backdrop" class="absolute inset-0 z-0 bg-black"></div>

  <div
    class="relative z-10 flex items-center justify-between p-3 text-white sm:p-4"
  >
    <span id="lb-counter" class="text-sm opacity-70"></span>
    <div class="flex items-center gap-1">
      <button
        id="lb-info-toggle"
        aria-label="Más información"
        class="btn btn-ghost btn-circle btn-sm text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-5 w-5"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <line x1="12" y1="11" x2="12" y2="16"></line>
          <circle cx="12" cy="8" r="0.5" fill="currentColor"></circle>
        </svg>
      </button>
      <button
        id="lb-close"
        aria-label="Cerrar"
        class="btn btn-ghost btn-circle btn-sm text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-5 w-5"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="lb-stage"
    class="relative z-10 flex flex-1 items-center justify-center overflow-hidden"
  >
    <button
      id="lb-prev"
      aria-label="Anterior"
      class="btn btn-ghost btn-circle absolute left-2 top-1/2 hidden -translate-y-1/2 text-white sm:flex"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="h-6 w-6"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <picture class="contents">
      <source id="lb-source-avif" type="image/avif" />
      <source id="lb-source-webp" type="image/webp" />
      <img
        id="lb-img"
        src=""
        alt=""
        draggable="false"
        class="max-h-[75vh] max-w-[92vw] select-none object-contain"
        style="touch-action:pinch-zoom"
      />
    </picture>

    <div
      id="lb-loader"
      class="pointer-events-none absolute inset-0 z-20 hidden items-center justify-center"
      aria-hidden="true"
    >
      <span
        class="h-9 w-9 animate-spin rounded-full border-2 border-white/25 border-t-white"
      ></span>
    </div>

    <button
      id="lb-next"
      aria-label="Siguiente"
      class="btn btn-ghost btn-circle absolute right-2 top-1/2 hidden -translate-y-1/2 text-white sm:flex"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="h-6 w-6"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <div
    id="lb-info"
    class="absolute inset-x-0 bottom-0 z-10 max-h-[45vh] overflow-y-auto rounded-t-2xl bg-base-100 p-5 pb-8 text-base-content"
  >
    <div class="mx-auto mb-3 h-1.5 w-10 rounded-full bg-base-300 sm:hidden">
    </div>
    <h3 id="lb-title" class="text-lg font-bold"></h3>
    <p id="lb-date" class="mt-0.5 text-xs opacity-60"></p>
    <p id="lb-desc" class="mt-1 text-sm opacity-80"></p>
    <div id="lb-tags" class="mt-3 flex flex-wrap gap-2"></div>
  </div>
</div>

<style>
  #lb-info {
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  #lb-info.open {
    transform: translateY(0);
  }
  #lb-backdrop {
    opacity: 0.95;
    transition: opacity 0.25s ease;
  }
  #lb-img {
    transition: transform 0.25s ease;
  }
  @media (pointer: coarse) {
    #lb-info-toggle {
      display: none;
    }
  }
  ::view-transition-old(gallery-photo),
  ::view-transition-new(gallery-photo) {
    animation-duration: 0.35s;
  }
</style>

<script>
  function setupLightbox() {
    const lightbox = document.getElementById("lightbox")!;
    const backdrop = document.getElementById("lb-backdrop")!;
    const stage = document.getElementById("lb-stage")!;
    const lbImg = document.getElementById("lb-img") as HTMLImageElement;
    const lbSourceAvif = document.getElementById(
      "lb-source-avif",
    ) as HTMLSourceElement;
    const lbSourceWebp = document.getElementById(
      "lb-source-webp",
    ) as HTMLSourceElement;
    const lbTitle = document.getElementById("lb-title")!;
    const lbDate = document.getElementById("lb-date")!;
    const lbDesc = document.getElementById("lb-desc")!;
    const lbTags = document.getElementById("lb-tags")!;
    const lbCounter = document.getElementById("lb-counter")!;
    const loader = document.getElementById("lb-loader")!;
    const infoPanel = document.getElementById("lb-info")!;
    const btnClose = document.getElementById("lb-close")!;
    const btnInfo = document.getElementById("lb-info-toggle")!;
    const btnPrev = document.getElementById("lb-prev")!;
    const btnNext = document.getElementById("lb-next")!;

    // Si <Lightbox /> se ha usado dentro de un contenedor con
    // transform/filter/perspective/contain (p.ej. un <article class="prose">,
    // un drawer, un wrapper de layout…), ese ancestro se convierte en el
    // "containing block" de position:fixed y el overlay deja de cubrir
    // toda la pantalla. Lo evitamos moviendo el nodo directamente bajo
    // <body> en cada carga de página, sea cual sea su posición original.
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    let photos: any[] = [];
    let current = 0;
    let infoOpen = false;
    let currentTriggerEl: HTMLElement | null = null; // el botón/thumbnail clicado

    // ── Preload ───────────────────────────────────────────────────
    const preloaded = new Set<number>();
    function preloadPhoto(i: number) {
      const p = photos[i];
      if (!p || preloaded.has(i)) return;
      preloaded.add(i);
      const img = new Image();
      img.src = p.src;
      if (p.srcAvif) {
        const a = new Image();
        a.src = p.srcAvif;
      }
    }
    function preloadNeighbors(index: number) {
      preloadPhoto(index);
      if (photos.length <= 1) return;
      preloadPhoto((index + 1) % photos.length);
      preloadPhoto((index - 1 + photos.length) % photos.length);
    }

    // ── View Transition ───────────────────────────────────────────
    function canAnimate() {
      return (
        typeof document.startViewTransition === "function" &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      );
    }

    // Limpia ambos nombres al terminar para que no interfieran
    // con la navegación entre páginas de Astro (View Transitions de router).
    function clearNames() {
      lbImg.style.viewTransitionName = "";
      if (currentTriggerEl) {
        currentTriggerEl.style.viewTransitionName = "";
        currentTriggerEl.removeAttribute("data-lb-trigger-active");
      }
    }

    function markTrigger(el: HTMLElement, name: string) {
      el.style.viewTransitionName = name;
      el.setAttribute("data-lb-trigger-active", "");
    }

    // Silencia temporalmente los transition:name estáticos de otros elementos
    // (HorizontalCard, etc.) para que no participen en la transición del lightbox.
    // Devuelve una función para restaurarlos al terminar.
    function silenceOtherTransitionNames(): () => void {
      const affected: Array<{ el: HTMLElement; name: string }> = [];
      document
        .querySelectorAll<HTMLElement>('[style*="view-transition-name"]')
        .forEach((el) => {
          if (el !== lbImg && !el.hasAttribute("data-lb-trigger-active")) {
            affected.push({ el, name: el.style.viewTransitionName });
            el.style.viewTransitionName = "none";
          }
        });
      // También silenciamos los que llevan transition:name via CSS de Astro
      // (aparecen como propiedad de estilo computado, no inline)
      document
        .querySelectorAll<HTMLElement>("[data-astro-transition-scope]")
        .forEach((el) => {
          if (el !== lbImg && !el.hasAttribute("data-lb-trigger-active")) {
            const computed = getComputedStyle(el).viewTransitionName;
            if (computed && computed !== "none" && computed !== "auto") {
              affected.push({ el, name: "" }); // '' = dejar que vuelva al CSS
              el.style.viewTransitionName = "none";
            }
          }
        });
      return () => {
        affected.forEach(({ el, name }) => {
          el.style.viewTransitionName = name;
        });
      };
    }

    // withTransition gestiona el nombre en AMBOS elementos dinámicamente:
    // nunca está declarado en HTML, así que no contamina otras transiciones.
    function withTransition(triggerEl: HTMLElement | null, mutate: () => void) {
      if (!canAnimate() || !triggerEl) {
        mutate();
        return;
      }

      const opening = lightbox.classList.contains("hidden");

      if (opening) {
        // ABRIR: thumbnail = "old", lb-img recibirá el nombre tras mutar
        markTrigger(triggerEl, "gallery-photo");
      } else {
        // CERRAR: lb-img = "old"
        lbImg.style.viewTransitionName = "gallery-photo";
      }

      // Silenciar otros elementos con transition:name antes de capturar
      const restore = silenceOtherTransitionNames();

      const transition = document.startViewTransition(() => {
        mutate();
        if (opening) {
          // Lightbox ya abierto: lb-img es el "new", thumbnail suelta el nombre
          triggerEl.style.viewTransitionName = "";
          triggerEl.removeAttribute("data-lb-trigger-active");
          lbImg.style.viewTransitionName = "gallery-photo";
        } else {
          // Lightbox ya cerrado: thumbnail es el "new", lb-img suelta el nombre
          lbImg.style.viewTransitionName = "";
          markTrigger(triggerEl, "gallery-photo");
        }
      });

      // Al terminar: limpiamos los nombres del lightbox y restauramos el resto
      transition.finished.finally(() => {
        clearNames();
        restore();
      });
    }

    // ── Loader ────────────────────────────────────────────────────
    let loadToken = 0;
    function showLoader() {
      loader.classList.replace("hidden", "flex");
    }
    function hideLoader() {
      loader.classList.replace("flex", "hidden");
    }

    // ── Render ────────────────────────────────────────────────────
    function render() {
      const p = photos[current];
      loadToken += 1;
      const myToken = loadToken;
      let ready = false;
      hideLoader();

      lbImg.onload = () => {
        if (myToken === loadToken) {
          ready = true;
          hideLoader();
        }
      };
      lbImg.onerror = () => {
        if (myToken === loadToken) {
          ready = true;
          hideLoader();
        }
      };
      window.setTimeout(() => {
        if (!ready && myToken === loadToken) showLoader();
      }, 150);

      if (p.srcAvif) {
        lbSourceAvif.srcset = p.srcAvif;
      } else {
        lbSourceAvif.removeAttribute("srcset");
      }
      lbSourceWebp.srcset = p.src;
      lbImg.src = p.src;
      lbImg.alt = p.title ?? "";
      if (p.width && p.height)
        lbImg.style.aspectRatio = `${p.width} / ${p.height}`;

      lbTitle.textContent = p.title ?? "";
      lbTitle.classList.toggle("hidden", !p.title);

      const dateText = formatDate(p.pubDate);
      lbDate.textContent = dateText;
      lbDate.classList.toggle("hidden", !dateText);

      lbDesc.textContent = p.description ?? "";
      lbDesc.classList.toggle("hidden", !p.description);

      lbTags.innerHTML = "";
      const tags = p.tags ?? [];
      tags.forEach((tag: string) => {
        const span = document.createElement("span");
        span.className = "badge badge-outline badge-sm";
        span.textContent = `#${tag}`;
        lbTags.appendChild(span);
      });
      lbTags.classList.toggle("hidden", tags.length === 0);

      lbCounter.textContent =
        photos.length > 1 ? `${current + 1} / ${photos.length}` : "";
    }

    function formatDate(ts: any) {
      if (ts === undefined || ts === null || ts === "") return "";
      const ms = Number(ts) < 1e12 ? Number(ts) * 1000 : Number(ts);
      const d = new Date(ms);
      if (isNaN(d.getTime())) return "";
      return new Intl.DateTimeFormat("es-ES", {
        day: "numeric",
        month: "long",
        year: "numeric",
      }).format(d);
    }

    function updateNavButtons() {
      const multiple = photos.length > 1;
      btnPrev.classList.toggle("sm:flex", multiple);
      btnNext.classList.toggle("sm:flex", multiple);
    }

    function resetDragStyles() {
      lbImg.style.transition = "";
      lbImg.style.transform = "";
      backdrop.style.transition = "";
      backdrop.style.opacity = "";
      infoPanel.style.transition = "";
      infoPanel.style.transform = "";
    }

    // ── Abrir / Cerrar / Navegar ──────────────────────────────────
    function open(index: number, triggerEl: HTMLElement | null) {
      resetDragStyles();
      currentTriggerEl = triggerEl;
      preloadNeighbors(index);
      withTransition(triggerEl, () => {
        current = index;
        render();
        updateNavButtons();
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
      });
    }

    function close() {
      infoOpen = false;
      infoPanel.classList.remove("open");
      hideLoader();
      withTransition(currentTriggerEl, () => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
        resetDragStyles();
      });
    }

    function go(delta: number) {
      const newIndex = (current + delta + photos.length) % photos.length;
      preloadNeighbors(newIndex);
      current = newIndex;
      render();
    }

    function toggleInfo(force?: boolean) {
      infoOpen = force !== undefined ? force : !infoOpen;
      infoPanel.classList.toggle("open", infoOpen);
    }

    // ── Escucha el evento global ──────────────────────────────────

    // Precarga disparada desde hover/touchstart externo (gallery, index…)
    document.addEventListener("lightbox:preload", (e: Event) => {
      const { photos: newPhotos, index } = (e as CustomEvent).detail;
      // Adoptamos el set si es nuevo, sin abrir el lightbox
      if (newPhotos !== photos) {
        preloaded.clear();
        photos = newPhotos;
      }
      preloadNeighbors(index);
    });

    document.addEventListener("lightbox:open", (e: Event) => {
      const {
        photos: newPhotos,
        index = 0,
        triggerEl = null,
      } = (e as CustomEvent).detail;
      // Resetear preloaded al cambiar el set de fotos
      if (newPhotos !== photos) preloaded.clear();
      photos = newPhotos;
      // Precargar en idle el resto del set nuevo
      const schedule =
        (window as any).requestIdleCallback ||
        ((cb: any) => setTimeout(cb, 200));
      schedule(() => {
        photos.forEach((_, i) => preloadPhoto(i));
      });
      open(index, triggerEl);
    });

    // ── Controles de UI ───────────────────────────────────────────
    btnClose.addEventListener("click", close);
    btnInfo.addEventListener("click", () => toggleInfo());
    btnPrev.addEventListener("click", () => go(-1));
    btnNext.addEventListener("click", () => go(1));
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowRight") go(1);
      if (e.key === "ArrowLeft") go(-1);
      if (e.key === "ArrowUp") toggleInfo(true);
      if (e.key === "ArrowDown") toggleInfo(false);
    });

    // ── Gestos táctiles ───────────────────────────────────────────
    const LOCK_THRESHOLD = 8;
    const SWIPE_THRESHOLD = 45;
    const OPEN_INFO_DISTANCE = 140;
    const OPEN_INFO_COMMIT = 0.35;
    const DISMISS_FADE_DISTANCE = 280;
    const DISMISS_COMMIT_PX = 120;
    const FLING_VELOCITY = 0.55;

    let touchStartX = 0,
      touchStartY = 0;
    let touching = false;
    let axis: "x" | "y" | null = null;
    let verticalMode: "open-info" | "close-info" | "dismiss" | null = null;
    let infoPanelHeight = 0;
    let lastY = 0,
      lastT = 0,
      velocityY = 0;

    function setDragTransition(on: boolean) {
      lbImg.style.transition = on ? "" : "none";
      backdrop.style.transition = on ? "" : "none";
      infoPanel.style.transition = on ? "" : "none";
    }

    stage.addEventListener(
      "touchstart",
      (e) => {
        if (e.touches.length > 1) return;
        touching = true;
        axis = null;
        verticalMode = null;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        lastY = touchStartY;
        lastT = e.timeStamp;
        velocityY = 0;
        infoPanelHeight = infoPanel.getBoundingClientRect().height || 300;
        setDragTransition(false);
      },
      { passive: true },
    );

    stage.addEventListener(
      "touchmove",
      (e) => {
        if (!touching || e.touches.length > 1) return;
        const x = e.touches[0].clientX,
          y = e.touches[0].clientY;
        const dx = x - touchStartX,
          dy = y - touchStartY;
        const dt = e.timeStamp - lastT;
        if (dt > 0) velocityY = (y - lastY) / dt;
        lastY = y;
        lastT = e.timeStamp;

        if (axis === null) {
          if (Math.abs(dx) < LOCK_THRESHOLD && Math.abs(dy) < LOCK_THRESHOLD)
            return;
          axis = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
          if (axis === "y") {
            verticalMode =
              dy < 0
                ? infoOpen
                  ? null
                  : "open-info"
                : infoOpen
                  ? "close-info"
                  : "dismiss";
          }
        }
        if (axis !== "y" || !verticalMode) return;

        if (verticalMode === "open-info") {
          const progress = Math.min(1, Math.max(0, -dy / OPEN_INFO_DISTANCE));
          infoPanel.style.transform = `translateY(${(1 - progress) * 100}%)`;
        } else if (verticalMode === "close-info") {
          const progress = Math.min(1, Math.max(0, dy / infoPanelHeight));
          infoPanel.style.transform = `translateY(${progress * 100}%)`;
        } else if (verticalMode === "dismiss") {
          const clampedDy = Math.max(0, dy);
          lbImg.style.transform = `translateY(${clampedDy}px)`;
          backdrop.style.opacity = String(
            0.95 - Math.min(1, clampedDy / DISMISS_FADE_DISTANCE) * 0.8,
          );
        }
      },
      { passive: true },
    );

    stage.addEventListener(
      "touchend",
      (e) => {
        if (!touching) return;
        touching = false;
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        setDragTransition(true);

        if (axis === "x") {
          if (Math.abs(dx) >= SWIPE_THRESHOLD) dx < 0 ? go(1) : go(-1);
          axis = null;
          verticalMode = null;
          return;
        }
        if (axis !== "y" || !verticalMode) {
          axis = null;
          verticalMode = null;
          return;
        }

        if (verticalMode === "open-info") {
          const progress = Math.min(1, Math.max(0, -dy / OPEN_INFO_DISTANCE));
          const commit =
            progress > OPEN_INFO_COMMIT || velocityY < -FLING_VELOCITY;
          infoPanel.style.transform = "";
          infoOpen = commit;
          infoPanel.classList.toggle("open", commit);
        } else if (verticalMode === "close-info") {
          const progress = Math.min(1, Math.max(0, dy / infoPanelHeight));
          const commit =
            progress > OPEN_INFO_COMMIT || velocityY > FLING_VELOCITY;
          infoPanel.style.transform = "";
          infoOpen = !commit;
          infoPanel.classList.toggle("open", !commit);
        } else if (verticalMode === "dismiss") {
          const clampedDy = Math.max(0, dy);
          const commit =
            clampedDy > DISMISS_COMMIT_PX || velocityY > FLING_VELOCITY;
          if (commit) {
            lbImg.style.transform = "translateY(120%)";
            backdrop.style.opacity = "0";
            window.setTimeout(() => {
              lightbox.classList.add("hidden");
              lightbox.classList.remove("flex");
              document.body.style.overflow = "";
              resetDragStyles();
            }, 220);
          } else {
            lbImg.style.transform = "";
            backdrop.style.opacity = "";
          }
        }
        axis = null;
        verticalMode = null;
      },
      { passive: true },
    );
  }

  document.addEventListener("astro:page-load", setupLightbox);

  // Este listener vive FUERA de setupLightbox para que se registre
  // una sola vez y persista entre navegaciones de ClientRouter.
  // astro:before-preparation se dispara justo antes de que Astro
  // capture el estado "viejo" de la página para su transición de router.
  // Si en ese momento lb-img o el thumbnail tienen viewTransitionName,
  // Astro los incluye en su animación aunque no tengan nada que ver.
  // Solución: forzar viewTransitionName = 'none' en lb-img siempre
  // que el lightbox esté cerrado, y limpiar el thumbnail por si acaso.
  document.addEventListener("astro:before-preparation", () => {
    // lb-img: si el lightbox está oculto, el nombre no debe existir
    const lb = document.getElementById("lightbox");
    const img = document.getElementById("lb-img") as HTMLElement | null;
    if (img && lb?.classList.contains("hidden")) {
      img.style.viewTransitionName = "";
    }
    // Thumbnail: recorremos todos los elementos que pudieran tener
    // el nombre asignado dinámicamente y los limpiamos.
    // Usamos un atributo data- como marca en vez de buscar por valor CSS.
    document.querySelectorAll("[data-lb-trigger-active]").forEach((el) => {
      (el as HTMLElement).style.viewTransitionName = "";
      el.removeAttribute("data-lb-trigger-active");
    });
  });
</script>

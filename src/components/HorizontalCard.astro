---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row items-start pb-0">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-52 rounded-lg"
            transition:name=`img-${title}`
          />
        )
      }
      <div class="grow w-full">
        <h2 class="text-xl font-bold">
          <span transition:name=`title-${title}`>{title}</span>
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h2>
        <p class="py-1 text-1xl">{desc}</p>
      </div>
    </div>
    </a>
        <div class="card-actions justify-end pb-3 px-6">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge border-current">
                  {tag}
                </a>
              ))
          }
        </div>
</div>

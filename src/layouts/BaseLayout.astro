---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SideBar from "@components/SideBar.astro";
import BackButton from "@components/BackButton.astro";
import Analytics from "@components/Analytics.astro";
import { getLangFromUrl } from "../i18n/utils";
import { ClientRouter } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  imageWidth,
  imageHeight,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  langAlternates,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang} data-theme="lofi">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      ogType={ogType}
    />
    {TRANSITION_API && <ClientRouter />}

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Aitor Ibañez",
        url: "https://aitor.info",
        jobTitle: "Operario de Horticultura y Jardinería",
        description: "Operario especializado en horticultura y jardinería.",
        knowsAbout: [
          "Horticultura",
          "Jardinería",
          "Huerta",
          "Mantenimiento de jardines",
        ],
        hasOccupation: {
          "@type": "Occupation",
          name: "Operario de Horticultura y Jardinería",
        },
        address: {
          "@type": "PostalAddress",
          addressLocality: "San Sebastian",
          addressRegion: "País Vasco",
          addressCountry: "ES",
        },
        image: "https://aitor.info/profile.webp",
      })}
    />
  </head>
  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header title={SITE_TITLE} />
        <div class="hidden lg:block fixed top-4 right-4 z-30">
          <BackButton />
        </div>
        <div class="md:flex md:justify-center">
          <main class="p-6 pt-10 lg:pt-12 lg:max-w-[900px] max-w-[100vw]">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {
        includeSidebar && (
          <SideBar
            sideBarActiveItemID={sideBarActiveItemID}
            langAlternates={langAlternates}
          />
        )
      }
    </div>
    <Analytics />

    <script>
      function setupScrollHide() {
        const picker = document.getElementById("language-picker");
        if (!picker) return;
      }

      document.addEventListener("astro:page-load", setupScrollHide);
    </script>
  </body>
</html>

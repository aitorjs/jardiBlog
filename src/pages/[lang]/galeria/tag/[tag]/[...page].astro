---
import BaseLayout from "@layouts/BaseLayout.astro";
import PhotoLightboxGrid from "@components/PhotoLightboxGrid.astro";
import Lightbox from "@components/Lightbox.astro";
import { getCollection } from "astro:content";
import {
  locales,
  getLangFromUrl,
  useTranslations,
} from "../../../../../i18n/utils";

// Resuelve un campo que puede venir como string plano (fotos de blog,
// siempre en español) o como objeto localizado {es, eu} (fotos de la
// colección "gallery"). Con fallback a "es" si falta el idioma pedido.
function resolveField(field: unknown, lang: string) {
  if (field && typeof field === "object" && !Array.isArray(field)) {
    const localized = field as Record<string, string>;
    return localized[lang] ?? localized.es;
  }
  return field as string | undefined;
}

export async function getStaticPaths({ paginate }) {
  const gallery_photos = await getCollection("gallery");

  // Fotos sueltas definidas con "export const photos = [...]" dentro de
  // los .mdx del blog. No son entradas de content collections, así que
  // getCollection() no las ve: hay que recogerlas a mano con import.meta.glob.
  // Ajusta la ruta del glob si tu colección de blog vive en otra carpeta.
  const blogModules = import.meta.glob("/src/content/blog/**/*.mdx", {
    eager: true,
  }) as Record<string, { photos?: any[] }>;

  const mdx_photos = Object.values(blogModules).flatMap((mod: any) => {
    return Object.values(mod).flatMap((v: any) => {
      if (!Array.isArray(v)) return [];
      return v;
    });
  });

  // Unificamos ambas fuentes bajo la misma forma { data: {...} } para
  // reutilizar sin cambios el resto de la lógica de esta página, que
  // ya asume entry.data.X. title/description/alt se dejan SIN resolver
  // aquí (pueden ser string u objeto {es,eu}); se resuelven más abajo,
  // ya con el "lang" de la ruta concreta.
  const raw_photos = [
    ...gallery_photos.map((entry) => ({ data: entry.data })),
    ...mdx_photos.map((p) => ({
      data: {
        image: p.image,
        title: p.title,
        alt: p.alt,
        description: p.description,
        tags: p.tags ?? [],
        pubDate: p.pubDate,
      },
    })),
  ];

  // Deduplicamos por la ruta de la imagen, que identifica de forma
  // única a cada foto (tanto si viene de gallery como de un .mdx).
  const all_photos = Array.from(
    new Map(
      raw_photos.map((photo) => {
        const key =
          typeof photo.data.image === "string"
            ? photo.data.image
            : photo.data.image?.src;
        return [key, photo];
      }),
    ).values(),
  );

  // Los tags son iguales en todos los idiomas (nunca se traducen), así
  // que esto no depende de "lang".
  const all_tags = all_photos.flatMap((photo) => photo.data.tags || []);
  const unique_tags = [...new Set(all_tags)];

  // Las fotos son las mismas para ambos idiomas: generamos cada tag
  // paginado una vez por idioma soportado (producto cartesiano).
  return locales.flatMap((lang) =>
    unique_tags.flatMap((tag) => {
      const filtered_photos = all_photos.filter((photo) => {
        return photo.data.tags?.includes(tag);
      });
      return paginate(filtered_photos, {
        params: { lang, tag },
        pageSize: 20,
        props: { lang },
      });
    }),
  );
}

const { page } = Astro.props;
const params = Astro.params;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const photos = page.data.map((entry) => ({
  image: entry.data.image,
  title: resolveField(entry.data.title, lang),
  alt: resolveField(entry.data.alt, lang),
  description: resolveField(entry.data.description, lang),
  tags: entry.data.tags,
  pubDate: entry.data.pubDate,
}));
---

<BaseLayout
  title={t("gallery.tag", params.tag)}
  description={t("gallery.tag.description", params.tag)}
  sideBarActiveItemID="gallery"
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold">
      {t("gallery.tag.long", params.tag)}
    </h1>
  </div>

  <section class="gallery-section">
    {
      page.data.length === 0 ? (
        <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
          <p class="font-bold">{t("gallery.pre.noPhotos")}</p>
          <p>{t("gallery.noPhotos")}</p>
        </div>
      ) : (
        <PhotoLightboxGrid photos={photos} />
      )
    }
  </section>

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          {" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>{" "}
          {t("gallery.prev")}
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          {t("gallery.next")}{" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            {" "}
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>

  <Lightbox />
</BaseLayout>
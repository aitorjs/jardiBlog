---
import { locales } from "../../i18n/utils";
import { Image, getImage } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import { timeAgo } from "../../lib/timeAgo";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import Lightbox from "@components/Lightbox.astro";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Resuelve un campo que puede venir como string plano (fotos de blog) o
// como objeto localizado {es, eu} (fotos de la colección "gallery").
function resolveField(field: unknown, lang: string) {
  if (field && typeof field === "object" && !Array.isArray(field)) {
    const localized = field as Record<string, string>;
    return localized[lang] ?? localized.es;
  }
  return (field as string | undefined) ?? "";
}

// Importar la imagen wip como asset para que Astro la procese y hashee en build
import wipImageSrc from "../../assets/photo_2026-07-27_12-23-12.jpg";
const wipFull = await getImage({
  src: wipImageSrc,
  width: 1600,
  format: "webp",
  quality: 80,
});

import wipImageSrc2 from "../../assets/photo_2026-07-27_12-36-18.jpg";
const wipFull2 = await getImage({
  src: wipImageSrc2,
  width: 1600,
  format: "webp",
  quality: 80,
});

const workingOnSince = new Date("2026-08-24");

const last_posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const galleryEntries = (await getCollection("gallery"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Array de photos con la estructura que espera el Lightbox
const last_photos = galleryEntries.map((foto) => ({
  src: foto.data.image.src,
  srcAvif: null,
  thumbSrc: foto.data.image.src,
  title: resolveField(foto.data.title, lang) || resolveField(foto.data.alt, lang),
  description: resolveField(foto.data.description, lang),
  pubDate: foto.data.pubDate?.valueOf() ?? null,
  tags: foto.data.tags ?? [],
  width: foto.data.image.width,
  height: foto.data.image.height,
}));

const wipPhotos = [];
---

<BaseLayout
  sideBarActiveItemID="home"
  title={t("home.title")}
  description={t("home.description")}
>
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">{t("home.hello")} 👋</div>
    <h1 class="text-5xl font-bold">
      {t("home.me")}
      <span class="block text-3xl py-3 font-bold">{t("home.about")}</span>
    </h1>
    <div class="py-2">
      <text class="text-lg">
        {t("home.text")}
      </text>
    </div>
    <div class="mt-8 flex items-center space-x-3">
      <a class="btn btn-lg btn-primary" href={`/${lang}/cv`}>{t("home.readCV")}</a>
    </div>
  </div>

  <!-- ── Blog ─────────────────────────────────────────────────── -->
  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">{t("home.blog.text")}</div>
  </div>
  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title[lang]}
          img={post.data.heroImage}
          desc={post.data.description[lang]}
          url={`/${lang}/blog/${createSlug(post.data.title[lang], post.data.title[lang])}`}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <!-- ── Últimas fotos ─────────────────────────────────────────── -->
  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">{t("home.gallery.text")}</div>
  </div>

  <div class="grid mb-16">
    {
      galleryEntries.map((foto, i) => {
        const alt = resolveField(foto.data.alt, lang);
        return (
          <figure class="item">
            <button
              class="photo-trigger block w-full h-full group"
              data-index={i}
              aria-label={`${t("home.gallery.text.label")}: ${alt}`}
            >
              <Image
                src={foto.data.image}
                alt={alt}
                width={500}
                height={350}
                class="h-full w-full cursor-pointer object-cover transition-transform duration-300 group-hover:scale-105 rounded-lg"
              />
            </button>
          </figure>
        );
      })
    }
  </div>

  <!-- ── Trabajando en ─────────────────────────────────────────── -->
  <div
    class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-4 rounded-xl border border-gray-200 p-4"
  >
    <p class="text-lg">
      <span class="font-bold">{t("home.working.text")}</span> {t("home.working.on")}
    </p>
    <div class="flex items-center gap-2 whitespace-nowrap">
      <p class="text-gray-400">{timeAgo(workingOnSince, lang)}</p>
    </div>
  </div>

  <Lightbox />
</BaseLayout>

<script define:vars={{ last_photos, wipPhotos }}>
  function setupIndexTriggers() {
    const photoButtons = Array.from(
      document.querySelectorAll(".photo-trigger"),
    );

    photoButtons.forEach((btn, i) => {
      btn.addEventListener("mouseenter", () => {
        document.dispatchEvent(
          new CustomEvent("lightbox:preload", {
            detail: { photos: last_photos, index: i },
          }),
        );
      });
      btn.addEventListener(
        "touchstart",
        () => {
          document.dispatchEvent(
            new CustomEvent("lightbox:preload", {
              detail: { photos: last_photos, index: i },
            }),
          );
        },
        { passive: true },
      );

      btn.addEventListener("click", () => {
        document.dispatchEvent(
          new CustomEvent("lightbox:open", {
            detail: { photos: last_photos, index: i, triggerEl: btn },
          }),
        );
      });
    });

    const wipBtn = document.getElementById("wip-photo-btn");
    if (wipBtn) {
      wipBtn.addEventListener("click", () => {
        document.dispatchEvent(
          new CustomEvent("lightbox:open", {
            detail: { photos: wipPhotos, index: 0 },
          }),
        );
      });
    }
  }

  document.addEventListener("astro:page-load", setupIndexTriggers);
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .item {
    margin: 0;
  }
  .item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .item:nth-child(3) {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .item:nth-child(2) {
      display: none;
    }
  }
</style>
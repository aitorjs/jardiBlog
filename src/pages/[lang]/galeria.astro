---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import galleryMeta from "../../data/gallery.json";
import Lightbox from "@components/Lightbox.astro";
import { getLangFromUrl, useTranslations, locales } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t("gallery.title");
const description = t("gallery.title");
const PHOTOS_PER_PAGE = 20;

const imageFiles = import.meta.glob("../../assets/gallery/*.{jpg,jpeg,png,webp}", {
  eager: true,
});

const photos = await Promise.all(
  galleryMeta.map(async (item) => {
    const entry = Object.entries(imageFiles).find(([path]) =>
      path.includes(`/${item.id}.`),
    );
    if (!entry) {
      throw new Error(t("gallery.not.found", item.id));
    }
    const source = entry[1].default;

    const full = await getImage({ src: source, width: 1600, format: "webp", quality: 80 });
    const fullAvif = await getImage({ src: source, width: 1600, format: "avif", quality: 55 });
    const thumb = await getImage({ src: source, width: 500, height: 500, fit: "cover", format: "webp", quality: 70 });
    const thumbAvif = await getImage({ src: source, width: 500, height: 500, fit: "cover", format: "avif", quality: 50 });

    return {
      ...item,
      title: item.title[lang],
      description: item.description[lang],
      alt: item.alt[lang],
      src: full.src,
      srcAvif: fullAvif.src,
      thumbSrc: thumb.src,
      thumbSrcAvif: thumbAvif.src,
      width: full.attributes.width,
      height: full.attributes.height,
    };
  }),
);

const totalPages = Math.max(1, Math.ceil(photos.length / PHOTOS_PER_PAGE));
---

<BaseLayout title={title} description={description} sideBarActiveItemID="gallery">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">{t("gallery.title")}</h1>
  </div>

  <section class="gallery-section">
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4">
      {
        photos.map((photo, i) => {
          const page = Math.floor(i / PHOTOS_PER_PAGE) + 1;
          return (
            <button
              class={`gallery-item group relative aspect-square overflow-hidden rounded-xl bg-base-200 ${page === 1 ? "" : "hidden"}`}
              data-index={i}
              data-page={page}
              aria-label={`Ver foto: ${photo.title}`}
            >
              <picture class="contents">
                <source srcset={photo.thumbSrcAvif} type="image/avif" />
                <source srcset={photo.thumbSrc} type="image/webp" />
                <img
                  src={photo.thumbSrc}
                  alt={photo.alt}
                  width="500"
                  height="500"
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="h-full w-full cursor-pointer object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </picture>
            </button>
          );
        })
      }
    </div>

    {totalPages > 1 && <div class="scroll-sentinel h-1 w-full" />}
    <p class="gallery-status sr-only" aria-live="polite"></p>
  </section>

  <Lightbox />
</BaseLayout>

<script define:vars={{ photos, photosPerPage: PHOTOS_PER_PAGE }}>
  function setupGallery() {
    const items = Array.from(document.querySelectorAll(".gallery-item"));
    const sentinel = document.querySelector(".scroll-sentinel");
    const statusEl = document.querySelector(".gallery-status");
    const totalPages = Math.max(1, Math.ceil(photos.length / photosPerPage));

    let revealedPages = 1;
    const preloadedPages = new Set();

    function getPhotosForPage(page) {
      const start = (page - 1) * photosPerPage;
      return photos.slice(start, start + photosPerPage);
    }

    // Detecta UNA sola vez si el navegador soporta AVIF, para precargar
    // solo el formato que realmente se va a usar (igual que hace <picture>
    // de forma nativa) y no descargar webp + avif de cada foto.
    function checkAvifSupport() {
      return new Promise((resolve) => {
        const testImg = new Image();
        testImg.onload = () => resolve(testImg.width === 1);
        testImg.onerror = () => resolve(false);
        // Imagen AVIF de 1x1 codificada en base64, solo para el test
        testImg.src =
          "data:image/avif;base64,";
      });
    }

    // Se resuelve una sola vez al cargar el script y se reutiliza siempre
    const avifSupportedPromise = checkAvifSupport();

    // Descarga por adelantado las miniaturas de una página, usando solo el
    // formato que el navegador va a usar realmente (no ambos)
    async function preloadPageThumbnails(page) {
      if (page < 1 || page > totalPages || preloadedPages.has(page)) return;
      preloadedPages.add(page);
      const avifSupported = await avifSupportedPromise;
      getPhotosForPage(page).forEach((photo) => {
        const img = new Image();
        img.src = avifSupported ? photo.thumbSrcAvif : photo.thumbSrc;
      });
    }

    function revealPage(page) {
      items.forEach((item) => {
        if (parseInt(item.dataset.page, 10) === page) {
          item.classList.remove("hidden");
        }
      });
    }

    function updateStatus() {
      if (!statusEl) return;
      const shown = Math.min(revealedPages * photosPerPage, photos.length);
      statusEl.textContent = `Mostrando ${shown} de ${photos.length} fotos`;
    }

    // Solo la primera página se muestra al inicio (ya viene así desde el
    // servidor). Precargamos la segunda de inmediato para que esté lista
    // antes de que el usuario llegue al final de la primera.
    updateStatus();
    preloadPageThumbnails(2);

    if (sentinel && totalPages > 1) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || revealedPages >= totalPages) return;

            revealedPages += 1;
            revealPage(revealedPages);
            updateStatus();

            // Precarga el siguiente lote por adelantado, antes de que
            // el usuario se acerque al nuevo final de la página
            preloadPageThumbnails(revealedPages + 1);

            if (revealedPages >= totalPages) {
              observer.disconnect();
              sentinel.remove();
            }
          });
        },
        {
          // Se dispara ~600px antes de que el centinela entre en pantalla,
          // es decir, antes de que el usuario llegue al final real
          rootMargin: "600px 0px 600px 0px",
          threshold: 0,
        },
      );
      observer.observe(sentinel);
    } else if (sentinel) {
      sentinel.remove();
    }

    // Precarga en hover / touchstart de la imagen en grande (igual que el original)
    items.forEach((btn, i) => {
      btn.addEventListener("mouseenter", () => {
        document.dispatchEvent(
          new CustomEvent("lightbox:preload", { detail: { photos, index: i } }),
        );
      });
      btn.addEventListener(
        "touchstart",
        () => {
          document.dispatchEvent(
            new CustomEvent("lightbox:preload", {
              detail: { photos, index: i },
            }),
          );
        },
        { passive: true },
      );
    });

    // Clic: abre el lightbox pasando el elemento clicado como triggerEl
    items.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        document.dispatchEvent(
          new CustomEvent("lightbox:open", {
            detail: { photos, index: i, triggerEl: btn },
          }),
        );
      });
    });
  }

  document.addEventListener("astro:page-load", setupGallery);
</script>

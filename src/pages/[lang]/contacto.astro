---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations, locales } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sendingLabel = t("contact.field.sending");
const sendLabel = t("contact.field.send");
const successLabel = t("contact.success");
const errorLabel = t("contact.error");
const failLabel = t("contact.fail");

---

<BaseLayout
  title={t("contact.title")}
  description={t("contact.description")}
  sideBarActiveItemID="contacto"
>
  <div class="mb-5 flex">
    <h1 class="text-3xl w-full font-bold">{t("contact.name")}</h1>
  </div>

  <div class="mb-10 text-lg">
    {t("contact.message")}
  </div>

  <div class="flex justify-center">
    <div class="rounded-xl border border-gray-200 p-4 sm:p-6 w-full max-w-xl">
      <form id="form">
        <input
          type="hidden"
          name="access_key"
          value="1f1fdd8c-23eb-4d6e-ad05-91ce394a4373"
        />

        <div class="mb-5">
          <label for="name" class="block mb-2 font-medium"
            >{t("contact.field.name")}</label
          >
          <input
            id="name"
            type="text"
            name="name"
            placeholder="john doe"
            class="input input-bordered w-full"
            required
          />
        </div>

        <div class="mb-5">
          <label for="email" class="block mb-2 font-medium"
            >{t("contact.field.email")}</label
          >
          <input
            id="email"
            type="email"
            name="email"
            placeholder="johndoe@aitor.info"
            class="input input-bordered w-full"
            required
          />
        </div>

        <div class="mb-5">
          <label for="message" class="block mb-2 font-medium"
            >{t("contact.field.message")}</label
          >
          <textarea
            id="message"
            name="message"
            placeholder={t("contact.field.message.example")}
            class="textarea textarea-bordered w-full min-h-32"
            required></textarea>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary">
          <span id="btn-label">{t("contact.field.send")}</span>
        </button>

        <p
          id="result"
          role="status"
          aria-live="polite"
          class="mt-4 empty:hidden"
        >
        </p>
      </form>
    </div>
  </div>

  <script define:vars={{ sendingLabel, sendLabel, successLabel, errorLabel, failLabel }}>
    const form = document.getElementById("form");
    const result = document.getElementById("result");
    const submitBtn = document.getElementById("submit-btn");
    const btnLabel = document.getElementById("btn-label");
  
    function setLoading(isLoading) {
      submitBtn.disabled = isLoading;
      btnLabel.innerHTML = isLoading
        ? `<span class="loading loading-spinner loading-sm"></span> ${sendingLabel}`
        : sendLabel;
    }
  
    function showResult(type, message) {
      result.className = `mt-4 ${type === "success" ? "text-success" : "text-error"}`;
      result.innerHTML = `${type === "success" ? "✅" : "⚠️"} ${message}`;
    }
  
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      result.innerHTML = "";
      setLoading(true);
  
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });
  
        const data = await response.json();
        if (data.success) {
          showResult(
            "success",
            successLabel,
          );
          form.reset();
        } else {
          showResult(
            "error",
            data.message ?? errorLabel,
          );
        }
      } catch {
        showResult(
          "error",
          failLabel
        );
      } finally {
        setLoading(false);
      }
    });
  </script>
</BaseLayout>

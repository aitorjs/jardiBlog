---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { timeAgo } from "../lib/timeAgo";

const workingOnSince = new Date("2026-07-25");

const last_posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const last_photos = (await getCollection("gallery"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Kaixo 👋</div>
    <div class="text-5xl font-bold">Soy aitor</div>
    <div class="text-3xl py-3 font-bold">
      Viverista en jardinería y horticultor
    </div>
    <div class="py-2">
      <text class="text-lg">
        Bienvenido a mi pequeño rincón en la red. Escribiré sobre mis pruebas,
        errores y logros. Pondré fotos dentro de la galería. Puedes ver mi
        curriculum vitae. También, puedes escribirme 😀.
      </text>
    </div>
    <div class="mt-8 flex items-center space-x-3">
      <a class="btn btn-lg btn-primary" href="/cv">Leer CV</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">
      Últimas entradas de blog
    </div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Últimas fotos</div>
  </div>

  <div class="grid mb-16">
    {
      last_photos.map((foto) => (
        <figure class="item">
          <a
            href={foto.data.image.src}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full h-full group"
          >
            <Image
              src={foto.data.image}
              alt={foto.data.alt}
              width={500}
              height={350}
              class="h-full w-full cursor-pointer object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </a>
        </figure>
      ))
    }
  </div>

  <div
    class="relative rounded-xl border border-gray-200 p-4 sm:p-5 pr-20 sm:pr-24"
  >
    <span
      class="absolute top-3 right-3 sm:top-5 sm:right-5 text-gray-400 whitespace-nowrap"
    >
      {timeAgo(workingOnSince)}
    </span>
    <p class="text-base sm:text-lg">
      <span class="font-bold">Trabajando en</span> cuidar la huerta de verano 🥬🍅🫑🌶️
    </p>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .item {
    margin: 0;
  }

  .item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }

  /* Tablet: 2 columnas, ocultar la 3ra imagen */
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .item:nth-child(3) {
      display: none;
    }
  }

  /* Móvil: 1 columna, ocultar la 2da y 3ra */
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .item:nth-child(2) {
      display: none;
    }
  }
</style>

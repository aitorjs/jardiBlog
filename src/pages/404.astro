---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations, locales } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
---

<BaseLayout title={t("404.title")} includeSidebar={true}>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">🏝</h1>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <h3 class="text-2xl">
      {t("404.description")}
    </h3>
    <a class="btn btn-accent mt-9" href=`/${lang}`>{t("404.goto")}</a>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import galleryMeta from "../data/gallery.json";
import Lightbox from "../components/Lightbox.astro";

const title = "Galería";
const description = "Fotos del jardín";

const imageFiles = import.meta.glob("../assets/gallery/*.{jpg,jpeg,png,webp}", {
  eager: true,
});

const photos = await Promise.all(
  galleryMeta.map(async (item) => {
    const entry = Object.entries(imageFiles).find(([path]) =>
      path.includes(`/${item.id}.`),
    );
    if (!entry) {
      throw new Error(
        `No se encontró la imagen para "${item.id}" en src/assets/gallery`,
      );
    }
    const source = entry[1].default;

    const full = await getImage({
      src: source,
      width: 1600,
      format: "webp",
      quality: 80,
    });
    const fullAvif = await getImage({
      src: source,
      width: 1600,
      format: "avif",
      quality: 55,
    });
    const thumb = await getImage({
      src: source,
      width: 500,
      height: 500,
      fit: "cover",
      format: "webp",
      quality: 70,
    });
    const thumbAvif = await getImage({
      src: source,
      width: 500,
      height: 500,
      fit: "cover",
      format: "avif",
      quality: 50,
    });

    return {
      ...item,
      src: full.src,
      srcAvif: fullAvif.src,
      thumbSrc: thumb.src,
      thumbSrcAvif: thumbAvif.src,
      width: full.attributes.width,
      height: full.attributes.height,
    };
  }),
);
---

<BaseLayout
  title={title}
  description={description}
  sideBarActiveItemID="gallery"
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Galería de fotos</h1>
  </div>

  <section>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4">
      {
        photos.map((photo, i) => (
          <button
            class="gallery-item group relative aspect-square overflow-hidden rounded-xl bg-base-200"
            data-index={i}
            aria-label={`Ver foto: ${photo.title}`}
          >
            <picture class="contents">
              <source srcset={photo.thumbSrcAvif} type="image/avif" />
              <source srcset={photo.thumbSrc} type="image/webp" />
              <img
                src={photo.thumbSrc}
                alt={photo.title}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                class="h-full w-full cursor-pointer object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </picture>
          </button>
        ))
      }
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<script define:vars={{ photos }}>
  function setupGallery() {
    const items = Array.from(document.querySelectorAll(".gallery-item"));

    // Precarga en hover / touchstart (igual que en el original)
    items.forEach((btn, i) => {
      btn.addEventListener("mouseenter", () => {
        document.dispatchEvent(
          new CustomEvent("lightbox:preload", { detail: { photos, index: i } }),
        );
      });
      btn.addEventListener(
        "touchstart",
        () => {
          document.dispatchEvent(
            new CustomEvent("lightbox:preload", {
              detail: { photos, index: i },
            }),
          );
        },
        { passive: true },
      );
    });

    // Clic: abre el lightbox pasando el elemento clicado como triggerEl
    items.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        document.dispatchEvent(
          new CustomEvent("lightbox:open", {
            detail: { photos, index: i, triggerEl: btn },
          }),
        );
      });
    });
  }

  document.addEventListener("astro:page-load", setupGallery);
</script>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import PhotoLightboxGrid from "@components/PhotoLightboxGrid.astro";
import Lightbox from "@components/Lightbox.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const all_photos = await getCollection("gallery");
  const all_tags = all_photos.flatMap((photo) => photo.data.tags || []);
  const unique_tags = [...new Set(all_tags)];

  return unique_tags.flatMap((tag) => {
    const filtered_photos = all_photos.filter((photo) => {
      return photo.data.tags?.includes(tag);
    });
    return paginate(filtered_photos, {
      params: { tag },
      pageSize: 20,
    });
  });
}

const { page } = Astro.props;
const params = Astro.params;

const photos = page.data.map((entry) => ({
  image: entry.data.image,
  title: entry.data.title,
  alt: entry.data.alt,
  description: entry.data.description,
  tags: entry.data.tags,
  pubDate: entry.data.pubDate,
}));
---

<BaseLayout
  title={"Galería - " + params.tag}
  description={"Fotos con la etiqueta " + params.tag}
  sideBarActiveItemID="gallery"
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Galería - {params.tag}</h1>
  </div>

  <section class="gallery-section">
    {
      page.data.length === 0 ? (
        <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
          <p class="font-bold">¡Vaya!</p>
          <p>No hay fotos con esta etiqueta por ahora.</p>
        </div>
      ) : (
        <PhotoLightboxGrid photos={photos} />
      )
    }
  </section>

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          {" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>{" "}
          Fotos recientes
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          Fotos anteriores{" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            {" "}
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>

  <Lightbox />
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto"
  description="Contacta con Aitor Ibañez: operario en horticultura y jardinería con formación certificada y más de 15 años de experiencia previa en desarrollo de software."
  sideBarActiveItemID="contacto"
>
  <div class="mb-5 flex">
    <h1 class="text-3xl w-full font-bold">Contacto</h1>
  </div>

  <div class="mb-10 text-lg">
    Si quieres hablar sobre horticultura, jardinería, alguna colaboración o simplemente
    saludar, escríbeme por aquí. Respondo en cuanto pueda.
  </div>

  <div class="flex justify-center">
  <div class="rounded-xl border border-gray-200 p-4 sm:p-6 w-full max-w-xl">
    <form id="form">
      <input type="hidden" name="access_key" value="1f1fdd8c-23eb-4d6e-ad05-91ce394a4373" />

      <div class="mb-5">
        <label for="name" class="block mb-2 font-medium">Nombre *</label>
        <input
          id="name"
          type="text"
          name="name"
          placeholder="john doe"
          class="input input-bordered w-full"
          required
        />
      </div>

      <div class="mb-5">
        <label for="email" class="block mb-2 font-medium">Correo *</label>
        <input
          id="email"
          type="email"
          name="email"
          placeholder="johdoe@aitor.info"
          class="input input-bordered w-full"
          required
        />
      </div>

      <div class="mb-5">
        <label for="message" class="block mb-2 font-medium">Mensaje *</label>
        <textarea
          id="message"
          name="message"
          placeholder="Cuéntame en qué puedo ayudarte..."
          class="textarea textarea-bordered w-full min-h-32"
          required
        ></textarea>
      </div>

      <button type="submit" id="submit-btn" class="btn btn-primary">
        <span id="btn-label">Enviar</span>
      </button>

      <p id="result" role="status" aria-live="polite" class="mt-4 empty:hidden"></p>
    </form>
  </div>
</div>

  <script>
    const form = document.getElementById("form") as HTMLFormElement;
    const result = document.getElementById("result") as HTMLElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const btnLabel = document.getElementById("btn-label") as HTMLElement;

    function setLoading(isLoading: boolean) {
      submitBtn.disabled = isLoading;
      btnLabel.innerHTML = isLoading
        ? `<span class="loading loading-spinner loading-sm"></span> Enviando...`
        : "Enviar";
    }

    function showResult(type: "success" | "error", message: string) {
      result.className = `mt-4 ${type === "success" ? "text-success" : "text-error"}`;
      result.innerHTML = `${type === "success" ? "✅" : "⚠️"} ${message}`;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      result.innerHTML = "";
      setLoading(true);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await response.json();
        if (data.success) {
          showResult("success", "Contacto enviado correctamente. En breve me pondré en contacto. Eskerrik asko!");
          form.reset();
        } else {
          showResult("error", data.message ?? "Algo ha fallado. Inténtalo de nuevo.");
        }
      } catch {
        showResult("error", "No se ha podido enviar. Comprueba tu conexión e inténtalo de nuevo.");
      } finally {
        setLoading(false);
      }
    });
  </script>
</BaseLayout>